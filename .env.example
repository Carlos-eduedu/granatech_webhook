# Banco de dados
# Local (SQLite): sqlite:///./granatech_webhook.db
# Produção (PostgreSQL do Dokploy): copie a Internal Connection URL
# Aceita postgres://... ou postgresql://... (normalizada para psycopg 3)
DATABASE_URL=sqlite:///./granatech_webhook.db

# Token compartilhado do webhook. Vazio = sem autenticação (NÃO use em produção).
WEBHOOK_TOKEN=
WEBHOOK_TOKEN_HEADER=X-Webhook-Token

# Lista de IPs permitidos, separada por vírgula. Vazio = libera todos.
ALLOWED_IPS=

# true quando estiver atrás do Traefik do Dokploy (usa X-Forwarded-For).
TRUST_PROXY=false

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Usados por `uv run granatech-webhook`
HOST=0.0.0.0
PORT=8000
